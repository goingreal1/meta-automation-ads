{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(dashboard|dashboard_new|dashboard_v2|builder|login|setup-company|reset-password|index)\\.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/rv/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "https://rrkhkhgdxhmogxxtbvyt.supabase.co/functions/v1/mcp/_site"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://rrkhkhgdxhmogxxtbvyt.supabase.co/functions/v1/mcp/_site/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/icons/favicon-32.png"
    },
    {
      "source": "/oauth/consent",
      "destination": "/oauth/consent.html"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/s/:slug/:page",
      "destination": "/api/site?slug=:slug&page=:page"
    }
  ],
  "functions": {
    "api/site.js": {
      "includeFiles": "rv/**",
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "revora-sites.vercel.app"
        }
      ],
      "destination": "https://metaautomationads.vercel.app/",
      "permanent": false
    },
    {
      "source": "/(dashboard|dashboard_new|dashboard_v2|builder|login|setup-company|reset-password|index)\\.html",
      "has": [
        {
          "type": "host",
          "value": "revora-sites.vercel.app"
        }
      ],
      "destination": "https://metaautomationads.vercel.app/$1.html",
      "permanent": false
    },
    {
      "source": "/(sales-ginaris-herbal|wordpress-meta-pixel)\\.html",
      "has": [
        {
          "type": "host",
          "value": "revora-sites.vercel.app"
        }
      ],
      "destination": "https://metaautomationads.vercel.app/$1.html",
      "permanent": false
    }
  ]
}
