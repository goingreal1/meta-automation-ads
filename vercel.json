{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(dashboard|dashboard_new|dashboard_v2|builder|login|setup-company|reset-password|index)\\.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/rv/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "go.outreachhq.xyz"
        }
      ],
      "destination": "/run-ads.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "outreachhq.xyz"
        }
      ],
      "destination": "/run-ads.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.revoracrm.app"
        }
      ],
      "destination": "/help.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.revoracrm.online"
        }
      ],
      "destination": "/help.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "support.revoracrm.app"
        }
      ],
      "destination": "/contact.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "support.revoracrm.online"
        }
      ],
      "destination": "/contact.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "developers.revoracrm.app"
        }
      ],
      "destination": "/developers.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "developers.revoracrm.online"
        }
      ],
      "destination": "/developers.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "academy.revoracrm.app"
        }
      ],
      "destination": "/academy.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "academy.revoracrm.online"
        }
      ],
      "destination": "/academy.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dash.revoracrm.app"
        }
      ],
      "destination": "/dashboard_new.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "dash.revoracrm.online"
        }
      ],
      "destination": "/dashboard_new.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hq.revoracrm.app"
        }
      ],
      "destination": "/dashboard_new.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "hq.revoracrm.online"
        }
      ],
      "destination": "/dashboard_new.html"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://oicqtpjjwmgsiluvkmpu.supabase.co/functions/v1/mcp/_site/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://oicqtpjjwmgsiluvkmpu.supabase.co/functions/v1/mcp/_site/.well-known/oauth-protected-resource"
    },
    {
      "source": "/mcp",
      "destination": "https://oicqtpjjwmgsiluvkmpu.supabase.co/functions/v1/mcp/_site"
    },
    {
      "source": "/mcp/:path*",
      "destination": "https://oicqtpjjwmgsiluvkmpu.supabase.co/functions/v1/mcp/_site/:path*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/icons/favicon-32.png"
    },
    {
      "source": "/oauth/consent",
      "destination": "/oauth/consent.html"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/s/:slug/:page",
      "destination": "/api/site?slug=:slug&page=:page"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/help",
      "destination": "/help.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/security",
      "destination": "/security.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/developers",
      "destination": "/developers.html"
    },
    {
      "source": "/academy",
      "destination": "/academy.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/first-facebook-ad-nigeria",
      "destination": "/blog/first-facebook-ad-nigeria.html"
    },
    {
      "source": "/blog/what-is-real-roas",
      "destination": "/blog/what-is-real-roas.html"
    },
    {
      "source": "/blog/why-ad-accounts-get-restricted",
      "destination": "/blog/why-ad-accounts-get-restricted.html"
    },
    {
      "source": "/blog/whatsapp-or-website",
      "destination": "/blog/whatsapp-or-website.html"
    },
    {
      "source": "/integrations",
      "destination": "/integrations.html"
    },
    {
      "source": "/certificate",
      "destination": "/certificate.html"
    },
    {
      "source": "/ai",
      "destination": "/ai.html"
    }
  ],
  "functions": {
    "api/site.js": {
      "includeFiles": "rv/**",
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.outreachhq.xyz"
        }
      ],
      "destination": "https://outreachhq.xyz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.revoracrm.app"
        }
      ],
      "destination": "https://revoracrm.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.revoracrm.online"
        }
      ],
      "destination": "https://revoracrm.online/:path*",
      "permanent": true
    },
    {
      "source": "/(dashboard_new|dashboard|login|setup-company|reset-password)",
      "has": [
        {
          "type": "host",
          "value": "revoracrm.app"
        }
      ],
      "destination": "https://dash.revoracrm.app/$1",
      "permanent": false
    },
    {
      "source": "/(dashboard_new|dashboard|login|setup-company|reset-password)\\.html",
      "has": [
        {
          "type": "host",
          "value": "revoracrm.app"
        }
      ],
      "destination": "https://dash.revoracrm.app/$1",
      "permanent": false
    },
    {
      "source": "/(dashboard_new|dashboard|login|setup-company|reset-password)",
      "has": [
        {
          "type": "host",
          "value": "revoracrm.online"
        }
      ],
      "destination": "https://dash.revoracrm.online/$1",
      "permanent": false
    },
    {
      "source": "/(dashboard_new|dashboard|login|setup-company|reset-password)\\.html",
      "has": [
        {
          "type": "host",
          "value": "revoracrm.online"
        }
      ],
      "destination": "https://dash.revoracrm.online/$1",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "revora-sites.vercel.app"
        }
      ],
      "destination": "https://dash.revoracrm.online/",
      "permanent": false
    },
    {
      "source": "/(dashboard|dashboard_new|dashboard_v2|builder|login|setup-company|reset-password|index)\\.html",
      "has": [
        {
          "type": "host",
          "value": "revora-sites.vercel.app"
        }
      ],
      "destination": "https://dash.revoracrm.online/$1.html",
      "permanent": false
    },
    {
      "source": "/(sales-ginaris-herbal|wordpress-meta-pixel)\\.html",
      "has": [
        {
          "type": "host",
          "value": "revora-sites.vercel.app"
        }
      ],
      "destination": "https://dash.revoracrm.online/$1.html",
      "permanent": false
    }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/meta-dashboard-mobile-redesign-r9yva2": false,
      "claude/elegant-newton-1hvf2l": false
    }
  }
}
